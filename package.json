{
  "name": "laqta-ai-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Laqta AI - AI-powered video editing studio in the browser (AR/EN)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:logic && npm run test:dom && npm run test:acode",
    "test:logic": "node test/build.mjs && node test/.bundle.mjs",
    "test:dom": "node test/build-dom.mjs && node test/.dom-bundle.mjs",
    "build:acode": "node scripts/build-acode.mjs",
    "test:acode": "node scripts/build-acode.mjs && node test/acode.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "vite": "^5.4.11"
  }
}
